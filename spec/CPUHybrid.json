{
    "solver": ["Hybrid"],
    "Hybrid": {
        "max_iter": 10000,
        "relative_tolerance": 1e-12,
        "absolute_tolerance": 0,
        "block_size": 1,
        "theta": 0.5,
        "do_hybrid_precond": true,
        "select_bad_dofs_from_l1_norm": true,
        "decompose_subdomains": true,
        "gmm_jump_threshold": 10,
        "gmm_tol": 1e-3,
        "max_gmm_iterations": 20,
        "min_subdomain_size": 4,
        "expand_subdomains": true
    }
}